# Terminal artifact finalization needs the managed Foundation signing keychain
# and App Store Connect notarization fields, but no Sparkle, npm, or GitHub
# publication credentials.
# shellcheck source=.mac-release.env
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.mac-release.env"
MAC_RELEASE_OP_ENV_REFS=
MAC_RELEASE_SPARKLE_OP_REF=
